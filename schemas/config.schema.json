{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-dev-workflow/config.schema.json",
  "title": "AI Engineering Workflow configuration",
  "description": "Optional convention-based configuration for a repository adopting the AI Engineering Workflow Standard.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^0\\.1(?:\\.\\d+)?$"
    },
    "profile": {
      "type": "string",
      "enum": ["minimal", "standard", "monorepo"]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "root": { "type": "string" },
        "workspaces": { "type": "array", "items": { "type": "string" } }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instructionFiles": { "type": "array", "items": { "type": "string" } },
        "loadRelevantOnly": { "type": "boolean", "default": true }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": { "type": ["string", "null"] },
        "lint": { "type": ["string", "null"] },
        "typecheck": { "type": ["string", "null"] },
        "test": { "type": ["string", "null"] },
        "build": { "type": ["string", "null"] },
        "security": { "type": ["string", "null"] }
      }
    },
    "workflows": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "type": "string" },
        "directory": { "type": "string" },
        "skillsDirectory": { "type": "string" }
      }
    }
  }
}
